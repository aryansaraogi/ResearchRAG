# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier quotas are per model and per day. gemini-3.5-flash allows only 20 requests/day,
# too few for an evaluation run, so the default is Flash-Lite. Any model your key lists works.
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests per minute allowed by your Gemini tier (free tier ~10)
GEMINI_RPM=10

# Leave empty to use embedded Qdrant (data/qdrant_local, no Docker needed).
# Set to http://localhost:6333 to use the server from docker-compose.yml.
QDRANT_URL=
QDRANT_COLLECTION=papers

DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Cross-encoder cost is ~linear in candidates (~0.15s each on a 4-core CPU)
RERANK_CANDIDATES=20
